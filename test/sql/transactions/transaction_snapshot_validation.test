# name: test/sql/transactions/transaction_snapshot_validation.test
# description: Exported transaction snapshots: single-connection validation and token behaviour
# group: [transactions]

# Cases that need a second connection to observe the exporter's uncommitted rows live in
# test/api/test_transaction_snapshot.cpp: a snapshot token cannot be carried between connections
# from a .test file, because the runner has no way to capture a query result into a variable.

# ---------------------------------------------------------------- exporting

statement error
SELECT duckdb_export_snapshot()
----
must be called inside an explicit transaction

statement ok
BEGIN

# The token is a UUID, and exporting twice returns the same one for the same transaction.
statement ok
SET VARIABLE snapshot_id = (SELECT duckdb_export_snapshot())

query I
SELECT length(getvariable('snapshot_id'))
----
36

query I
SELECT getvariable('snapshot_id') = duckdb_export_snapshot()
----
true

statement ok
ROLLBACK

# A new transaction gets a new token.
statement ok
BEGIN

query I
SELECT getvariable('snapshot_id') = duckdb_export_snapshot()
----
false

statement ok
ROLLBACK

# ------------------------------------------------- exporting a named database

statement ok
BEGIN

statement error
SELECT duckdb_export_snapshot('does_not_exist')
----
does not exist

# The per-connection temporary and system catalogs are not shareable.
statement error
SELECT duckdb_export_snapshot('temp')
----
cannot be exported

statement error
SELECT duckdb_export_snapshot('system')
----
cannot be exported

statement ok
ROLLBACK

statement ok
ATTACH ':memory:' AS database_a

statement ok
ATTACH ':memory:' AS database_b

statement ok
CREATE TABLE database_a.main.values_table (value INTEGER)

statement ok
CREATE TABLE database_b.main.values_table (value INTEGER)

# With more than one candidate and no writes, the database to export is ambiguous.
statement ok
BEGIN

statement ok
SELECT * FROM database_a.main.values_table

statement ok
SELECT * FROM database_b.main.values_table

statement error
SELECT duckdb_export_snapshot()
----
ambiguous

# Naming the database resolves it.
statement ok
SELECT duckdb_export_snapshot('database_a')

statement ok
ROLLBACK

# A transaction that has written to one database cannot export another.
statement ok
BEGIN

statement ok
INSERT INTO database_b.main.values_table VALUES (1)

statement error
SELECT duckdb_export_snapshot('database_a')
----
has already modified

statement ok
ROLLBACK

# The write is what constrains the choice, so exporting the written database is fine.
statement ok
BEGIN

statement ok
INSERT INTO database_b.main.values_table VALUES (1)

statement ok
SELECT duckdb_export_snapshot('database_b')

statement ok
ROLLBACK

# A read-only transaction can be exported; participants are read-only regardless.
statement ok
BEGIN TRANSACTION READ ONLY

statement ok
SELECT duckdb_export_snapshot('database_a')

statement ok
ROLLBACK

# --------------------------------------------------- SET TRANSACTION SNAPSHOT

statement error
SET TRANSACTION SNAPSHOT 'irrelevant'
----
can only be used inside an explicit transaction

statement ok
BEGIN

statement error
SET TRANSACTION SNAPSHOT ''
----
requires a non-empty snapshot id

# Tokens are exact capabilities: an unknown or well-formed-but-wrong one is refused.
statement error
SET TRANSACTION SNAPSHOT 'not-a-token'
----
Snapshot is no longer available

statement error
SET TRANSACTION SNAPSHOT '6ba7b810-9dad-11d1-80b4-00c04fd430c8'
----
Snapshot is no longer available

# A connection cannot take part in its own exported transaction.
statement ok
SET VARIABLE own_id = (SELECT duckdb_export_snapshot('database_a'))

statement error
SET TRANSACTION SNAPSHOT '6ba7b810-9dad-11d1-80b4-00c04fd430c8'
----
already takes part in a shared transaction

statement ok
ROLLBACK

# A token does not survive the transaction that produced it.
statement ok
BEGIN

statement error
SET TRANSACTION SNAPSHOT 'not-a-token'
----
Snapshot is no longer available

statement ok
ROLLBACK
