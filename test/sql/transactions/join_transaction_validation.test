# name: test/sql/transactions/join_transaction_validation.test
# description: Validate shared transaction usage and capabilities
# group: [transactions]

statement error
SELECT duckdb_share_transaction()
----
must be called inside an explicit transaction

statement error
JOIN TRANSACTION 'invalid'
----
can only be used inside an explicit transaction

statement ok
BEGIN

statement error
JOIN TRANSACTION ''
----
requires a non-empty transaction id

statement ok
ROLLBACK

statement ok
BEGIN

statement error
JOIN TRANSACTION 'invalid'
----
Shared transaction is no longer available

statement ok
ROLLBACK

statement ok
BEGIN

statement error
JOIN TRANSACTION 'abc/memory'
----
Shared transaction is no longer available

statement ok
ROLLBACK
